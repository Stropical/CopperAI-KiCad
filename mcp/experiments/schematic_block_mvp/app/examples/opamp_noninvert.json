    { "id": "RF", "kind": "feedback_resistor", "pins": ["1", "2"], "value": "100k" },
    { "id": "RG", "kind": "gain_resistor", "pins": ["1", "2"], "value": "10k" },
    { "id": "C1", "kind": "bypass_cap", "pins": ["1", "2"], "value": "100nF" }
