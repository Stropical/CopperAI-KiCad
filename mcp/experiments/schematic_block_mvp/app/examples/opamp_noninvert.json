    { "name": "OUT", "members": ["U1.OUT", "RF.1"] },
    { "name": "FB_NET", "members": ["RF.2", "RG.1", "U1.IN-"] },
    { "name": "GND", "members": ["RG.2", "U1.V-", "C1.2"] },
    { "name": "VCC", "members": ["U1.V+", "C1.1"] }
  ],
  "constraints": {
    "flow": "left_to_right",
    "power_top_ground_bottom": true,
    "compact_feedback_loop": false
  }
